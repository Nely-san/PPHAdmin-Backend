# ==============================================================================
# PPHAdmin Backend Environment Configuration Template
# Copy this file to backend/.env and populate with your environment credentials.
# ==============================================================================

# Core Django Settings
# In production, DJANGO_SECRET_KEY is mandatory and DEBUG must be False.
DJANGO_SECRET_KEY=<set-in-secrets-manager>
SECRET_KEY=django-insecure-dev-only-fallback-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings (MySQL 8.0)
# DB_PASSWORD is mandatory; server will raise ImproperlyConfigured if omitted.
DB_ENGINE=django.db.backends.mysql
DB_NAME=pph-2026
DB_USER=root
DB_PASSWORD=<set-in-secrets-manager>
DB_HOST=localhost
DB_PORT=3306

# API Throttling Rates (rest_framework.throttling)
ANON_THROTTLE_RATE=60/minute
USER_THROTTLE_RATE=300/minute

# Email Backend Configuration (Password Reset & Notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=PPHAdmin Security <noreply@pphadmin.local>

# CORS Settings (Comma-separated allowed client web origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Google OAuth 2.0 (Optional - for Google Sign-In)
# Must match VITE_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<set-in-secrets-manager>
