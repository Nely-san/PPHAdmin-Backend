// Prisma Schema for PPHAdmin - Employee & OJT HRIS, Biometrics, Attendance & Payroll

generator client {
  provider                    = "prisma-client-py"
  recursive_type_depth        = 5
  enable_experimental_decimal = true
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  SUPER_ADMIN
  ADMIN
  HR_MANAGER
  PAYROLL_OFFICER
  EMPLOYEE
  OJT
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PersonType {
  EMPLOYEE
  OJT
}

enum EmploymentMode {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum RateType {
  DAILY
  MONTHLY
  HOURLY
}

enum PersonStatus {
  ACTIVE
  ARCHIVED
  ON_LEAVE
  COMPLETED
}

enum LogType {
  CHECK_IN
  CHECK_OUT
  BREAK_IN
  BREAK_OUT
  OVERTIME_IN
  OVERTIME_OUT
  UNKNOWN
}

enum ScheduleType {
  REGULAR
  REST_DAY
  HOLIDAY
  LEAVE
  BUSINESS_TRIP
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  BUSINESS_TRIP
  HOLIDAY
  REST_DAY
}

enum AbnormalStatus {
  PENDING
  JUSTIFIED
  RESOLVED
  EXCUSED
  UNEXCUSED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum PayrollItemType {
  EARNING
  DEDUCTION
  ADVANCE
  REIMBURSEMENT
}

// ==========================================
// MODELS
// ==========================================

model User {
  id            String                  @id @default(uuid())
  username      String                  @unique
  email         String?                 @unique
  passwordHash  String
  role          Role                    @default(EMPLOYEE)
  person        Person?
  isArchived    Boolean                 @default(false)
  notifications Notification[]
  preferences   NotificationPreference?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@map("users")
}

model Company {
  id          String       @id @default(uuid())
  name        String
  code        String?      @unique
  departments Department[]
  persons     Person[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("companies")
}

model Department {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  persons   Person[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

model Person {
  id             String         @id @default(uuid())
  biometricId    String?        @unique // Enrollment ID from biometric device (e.g. 1, 4, 13, 66)
  name           String
  personType     PersonType     @default(EMPLOYEE)
  employmentMode EmploymentMode @default(FULL_TIME)
  rateType       RateType       @default(DAILY)
  baseRate       Decimal        @default(0.00) @db.Decimal(10, 2)
  dateStarted    DateTime
  dateEnded      DateTime?
  status         PersonStatus   @default(ACTIVE)

  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  userId       String?     @unique
  user         User?       @relation(fields: [userId], references: [id])

  // OJT Specific Tracking Fields
  schoolName         String?
  coordinatorContact String?
  requiredOjtHours   Decimal? @default(0.00) @db.Decimal(10, 2)
  renderedOjtHours   Decimal? @default(0.00) @db.Decimal(10, 2)

  // Relations
  schedules           Schedule[]
  rawLogs             BiometricLog[]
  attendanceRecords   AttendanceRecord[]
  abnormalClockings   AbnormalClocking[]
  attendanceSummaries AttendanceSummary[]
  payrollRecords      PayrollRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([biometricId])
  @@index([companyId])
  @@index([departmentId])
  @@map("persons")
}

model Shift {
  id             String     @id @default(uuid())
  code           String     @unique // e.g. "1", "NORMAL", "FLEXI"
  name           String // e.g. "Standard Day Shift"
  startTime      String // e.g. "08:00"
  endTime        String // e.g. "17:00"
  breakStartTime String? // e.g. "12:00"
  breakEndTime   String? // e.g. "13:00"
  workHours      Decimal    @default(8.00) @db.Decimal(4, 2)
  isFlexible     Boolean    @default(false)
  schedules      Schedule[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("shifts")
}

model Schedule {
  id           String       @id @default(uuid())
  personId     String
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  shiftId      String?
  shift        Shift?       @relation(fields: [shiftId], references: [id])
  date         DateTime     @db.Date
  scheduleType ScheduleType @default(REGULAR)
  note         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([personId, date])
  @@index([date])
  @@map("schedules")
}

model BiometricImportBatch {
  id                String              @id @default(uuid())
  fileName          String
  periodStart       DateTime?           @db.Date
  periodEnd         DateTime?           @db.Date
  importedAt        DateTime            @default(now())
  recordsImported   Int                 @default(0)
  anomaliesDetected Int                 @default(0)
  rawLogs           BiometricLog[]
  attendanceRecords AttendanceRecord[]
  summaries         AttendanceSummary[]

  @@map("biometric_import_batches")
}

model BiometricLog {
  id          String                @id @default(uuid())
  personId    String?
  person      Person?               @relation(fields: [personId], references: [id], onDelete: SetNull)
  biometricId String
  timestamp   DateTime
  logType     LogType               @default(UNKNOWN)
  deviceId    String?
  batchId     String?
  batch       BiometricImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())

  @@index([biometricId, timestamp])
  @@index([personId])
  @@map("biometric_logs")
}

model AttendanceRecord {
  id       String   @id @default(uuid())
  personId String
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date

  // Specific Time Punches (from individual employee sheets e.g. 1.4.5)
  amIn        DateTime?
  amOut       DateTime?
  pmIn        DateTime?
  pmOut       DateTime?
  overtimeIn  DateTime?
  overtimeOut DateTime?

  // Aggregated Hours & Metrics
  actualHours            Decimal @default(0.00) @db.Decimal(6, 2)
  requiredHours          Decimal @default(8.00) @db.Decimal(6, 2)
  tardinessMinutes       Int     @default(0)
  tardinessCount         Int     @default(0)
  earlyLeaveMinutes      Int     @default(0)
  earlyLeaveCount        Int     @default(0)
  overtimeRegularMinutes Int     @default(0)
  overtimeSpecialMinutes Int     @default(0)

  // Status Flags
  status         AttendanceStatus @default(PRESENT)
  isAbsent       Boolean          @default(false)
  isLeave        Boolean          @default(false)
  isBusinessTrip Boolean          @default(false)
  isAbnormal     Boolean          @default(false)
  isLocked       Boolean          @default(false)

  batchId           String?
  batch             BiometricImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  payrollRecordId   String?
  payrollRecord     PayrollRecord?        @relation(fields: [payrollRecordId], references: [id], onDelete: SetNull)
  abnormalClockings AbnormalClocking[]
  memo              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personId, date])
  @@index([date])
  @@map("attendance_records")
}

model AbnormalClocking {
  id                 String            @id @default(uuid())
  attendanceRecordId String?
  attendanceRecord   AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  personId           String
  person             Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  date               DateTime          @db.Date

  amIn  String? // Recorded AM In string e.g. "13:48"
  amOut String? // Recorded AM Out string
  pmIn  String? // Recorded PM In string
  pmOut String? // Recorded PM Out string e.g. "18:23"

  tardinessMinutes     Int            @default(0)
  earlyLeaveMinutes    Int            @default(0)
  totalAbnormalMinutes Int            @default(0)
  reason               String?
  status               AbnormalStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId, date])
  @@map("abnormal_clockings")
}

model AttendancePeriod {
  id        String              @id @default(uuid())
  name      String // e.g. "2026/07/01 ~ 07/14 (PPH)"
  startDate DateTime            @db.Date
  endDate   DateTime            @db.Date
  isClosed  Boolean             @default(false)
  summaries AttendanceSummary[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@map("attendance_periods")
}

model AttendanceSummary {
  id       String                @id @default(uuid())
  periodId String
  period   AttendancePeriod      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  personId String
  person   Person                @relation(fields: [personId], references: [id], onDelete: Cascade)
  batchId  String?
  batch    BiometricImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  requiredHours     Decimal @default(0.00) @db.Decimal(8, 2)
  actualHours       Decimal @default(0.00) @db.Decimal(8, 2)
  tardinessCount    Int     @default(0)
  tardinessMinutes  Int     @default(0)
  earlyLeaveCount   Int     @default(0)
  earlyLeaveMinutes Int     @default(0)
  overtimeRegular   Decimal @default(0.00) @db.Decimal(8, 2)
  overtimeSpecial   Decimal @default(0.00) @db.Decimal(8, 2)

  requiredDays     Int @default(0)
  actualDays       Int @default(0)
  businessTripDays Int @default(0)
  absenceDays      Int @default(0)
  leaveDays        Int @default(0)

  bonusPayNote String?
  payDeduction Decimal? @db.Decimal(10, 2)
  actualPay    Decimal? @db.Decimal(10, 2)
  memo         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, personId])
  @@map("attendance_summaries")
}

model PayrollRecord {
  id              String        @id @default(uuid())
  personId        String
  person          Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  cutoffStart     DateTime      @db.Date
  cutoffEnd       DateTime      @db.Date
  grossPay        Decimal       @db.Decimal(12, 2)
  totalDeductions Decimal       @db.Decimal(12, 2)
  netPay          Decimal       @db.Decimal(12, 2)
  status          PayrollStatus @default(DRAFT)

  items             PayrollItem[]
  attendanceRecords AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId, cutoffStart, cutoffEnd])
  @@map("payroll_records")
}

model PayrollItem {
  id              String          @id @default(uuid())
  payrollRecordId String
  payrollRecord   PayrollRecord   @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  itemType        PayrollItemType
  description     String
  amount          Decimal         @db.Decimal(12, 2)

  @@map("payroll_items")
}

model Notification {
  id          String               @id @default(uuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  isRead      Boolean              @default(false)
  priority    NotificationPriority @default(MEDIUM)
  category    String               @default("INFO")
  actionUrl   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enableInApp      Boolean  @default(true)
  notifyAttendance Boolean  @default(true)
  notifyPayroll    Boolean  @default(true)
  notifyLeave      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("notification_preferences")
}

model AuditLog {
  id        String   @id @default(uuid())
  tableName String   @map("table_name")
  recordId  String   @map("record_id")
  action    String
  oldData   String?  @map("old_data") @db.Text
  newData   String?  @map("new_data") @db.Text
  changedBy String   @map("changed_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model SystemParameter {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?  @db.Text
  category    String   @default("GENERAL") // GENERAL, ATTENDANCE, PAYROLL, SECURITY
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_parameters")
}


